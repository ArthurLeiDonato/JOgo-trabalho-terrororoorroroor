        tela.blit(titulo, (65, 45))
        
        btn_voltar_s3.desenhar(tela)
        btn_tesouro.desenhar(tela)
        btn_porta_fuga.desenhar(tela)

    # --- EFEITO DE SUSTO (IMAGEM DO FLÁVIO + SOM) ---
    if susto_ativo:
        tela.fill((40, 0, 0))
        if img_flavio:
            pos_x = (LARGURA - img_flavio.get_width()) // 2
            pos_y = (ALTURA - img_flavio.get_height()) // 2
            tela.blit(img_flavio, (pos_x, pos_y))
        else:
            txt_susto = fonte_enorme.render("BOO! FLÁVIO!", True, BRANCO)
            tela.blit(txt_susto, (LARGURA // 2 - txt_susto.get_width() // 2, ALTURA // 2 - 25))

    # --- HUD INFERIOR (ESTILO INVENTÁRIO CLÁSSICO DE POINT-AND-CLICK) ---
