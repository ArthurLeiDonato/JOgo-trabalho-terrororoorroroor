# ==========================================
# 4. LOOP PRINCIPAL DO JOGO
# ==========================================
while True:
    tempo_atual = pygame.time.get_ticks()

    if susto_ativo and (tempo_atual - tempo_susto > duracao_susto_ms):
        susto_ativo = False

    for evento in pygame.event.get():
        if evento.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        elif evento.type == pygame.MOUSEBUTTONDOWN:
            if evento.button == 1:
                pos = evento.pos

                def disparar_susto():
                    global susto_ativo, tempo_susto
                    susto_ativo = True
                    tempo_susto = pygame.time.get_ticks()
                    if som_susto:
                        som_susto.play()

                # --- CLIQUES NA SALA 1 (HALL) ---
                if sala_atual == "sala_1":
                    if porta_quarto1.foi_clicado(pos):
                        sala_atual = "quarto_1"
                        mensagem_status = "Você entrou no Quarto do Relógio."
                        if random.random() < 0.3:
                            disparar_susto()

                    elif porta_quarto2.foi_clicado(pos):
                        if "Pé de Cabra" in inventario:
                            sala_atual = "quarto_2"
                            mensagem_status = "Você usou o Pé de Cabra para forçar a porta do cofre."
                        else:
                            mensagem_status = "A porta do cofre está trancada por uma barra pesada."
                            if random.random() < 0.4:
                                disparar_susto()

